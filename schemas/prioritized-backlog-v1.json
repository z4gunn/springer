{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springer.local/schemas/prioritized-backlog-v1.json",
  "title": "SPGR Prioritized Backlog v1",
  "description": "The ordered story rollup produced by spgr-prioritize-backlog. Distinct from user-story, which describes exactly one story: this type describes the ORDER over many. Registering it closes the gap the skill itself records ('the prioritized-backlog artifact type is not yet in the schema registry'), and it is the artifact the Linear board projection reads. Entries reference stories by story_id; the per-story user-story artifacts remain the source of truth for story content.",
  "allOf": [
    { "$ref": "https://springer.local/schemas/_envelope-v1.json" }
  ],
  "properties": {
    "artifact_type": { "const": "prioritized-backlog" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": ["backlog"],
      "properties": {
        "status": { "type": "string" },
        "run_id": { "type": "string" },
        "scoring_framework": { "type": "string" },
        "scoring_caveat": { "type": "string" },
        "epics": {
          "type": "array",
          "description": "Optional epic grouping. The board projection uses epic_id to name an issue's parent grouping.",
          "items": {
            "type": "object",
            "required": ["epic_id", "name"],
            "properties": {
              "epic_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "backlog_order": {
          "type": "array",
          "description": "Explicit story_id order. When absent, the order of the backlog array is used.",
          "items": { "type": "string" }
        },
        "backlog": {
          "type": "array",
          "minItems": 1,
          "description": "The ordered entries. Each references one user-story artifact by story_id and carries only the fields the ordering decision and the board projection need.",
          "items": {
            "type": "object",
            "required": ["story_id", "title"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "story_id": { "type": "string", "pattern": "^STORY-[0-9]{4}-[0-9]+$" },
              "title": { "type": "string", "minLength": 1 },
              "epic_id": { "type": ["string", "null"] },
              "priority_tier": { "type": "string" },
              "priority_score": { "type": "number" },
              "estimated_size": { "type": "string" },
              "dependencies": { "type": "array", "items": { "type": "string" } },
              "dependencies_met": { "type": "boolean" },
              "prd_goal_ref": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "tech_debt_slots": { "type": "array" },
        "deferred_stories": { "type": "array" },
        "mvp_scope": { "type": "object" },
        "backlog_rollup_note": { "type": "string" }
      }
    }
  }
}
