{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springer.local/schemas/prd-v1.json",
  "title": "SPGR Product Requirements Document v1",
  "allOf": [{ "$ref": "https://springer.local/schemas/_envelope-v1.json" }],
  "properties": {
    "artifact_type": { "const": "prd" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "problem_statement",
        "goals",
        "personas",
        "scope",
        "out_of_scope",
        "success_metrics"
      ],
      "properties": {
        "problem_statement": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "evidence_refs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["goal", "success_metric"],
            "properties": {
              "goal": { "type": "string" },
              "success_metric": { "type": "string" },
              "measurement_method": { "type": "string" }
            }
          }
        },
        "personas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["persona_id", "primary_use_case"],
            "properties": {
              "persona_id": { "type": "string" },
              "primary_use_case": { "type": "string" }
            }
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "rationale"],
            "properties": {
              "feature": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "reason_excluded"],
            "properties": {
              "item": { "type": "string" },
              "reason_excluded": { "type": "string" }
            }
          }
        },
        "user_stories_overview": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nfr_summary": {
          "type": "object",
          "properties": {
            "performance": { "type": "string" },
            "security": { "type": "string" },
            "availability": { "type": "string" },
            "scalability": { "type": "string" },
            "compliance": { "type": "string" }
          }
        },
        "success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric", "target", "measurement"],
            "properties": {
              "metric": { "type": "string" },
              "target": { "type": "string" },
              "measurement": { "type": "string" }
            }
          }
        },
        "activation_event": {
          "type": "object",
          "description": "The one user action that shows the product delivered its value. Required by spgr-write-prd on saas and mobile, absent on brochure. Onboarding is scoped to the shortest path to it, and no paywall shows before it.",
          "required": ["name", "definition", "measured_by"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "definition": {
              "type": "string",
              "minLength": 1,
              "description": "What the user has done when the event fires, in observable terms."
            },
            "measured_by": {
              "type": "string",
              "minLength": 1,
              "description": "The analytics event or query that counts it, named so the event taxonomy can carry it."
            }
          }
        },
        "open_questions": {
          "type": "array",
          "description": "The intake question sweep: every fact, asset, preference, and constraint the run will need from the human, asked once at the first gate.",
          "items": {
            "type": "object",
            "required": ["question"],
            "properties": {
              "question": { "type": "string" },
              "owner": { "type": "string" },
              "deadline": { "type": "string" },
              "recommended_default": {
                "type": "string",
                "description": "The answer the run takes if the human accepts defaults. A missing fact defaults to a visible placeholder, never an invented value."
              },
              "blocking": {
                "type": "boolean",
                "description": "True when no default is acceptable, per the decision classes in .claude/references/pdca-harness.md. A blocking question holds the work that consumes it."
              },
              "consumed_by": {
                "type": "string",
                "description": "The story id or phase that needs the answer."
              }
            }
          }
        }
      }
    }
  }
}
