{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springer.local/schemas/hil-checkpoint-v1.json",
  "title": "SPGR Human-in-the-Loop Checkpoint v1",
  "allOf": [{ "$ref": "https://springer.local/schemas/_envelope-v1.json" }],
  "properties": {
    "artifact_type": { "const": "hil-checkpoint" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "checkpoint_type",
        "artifact_ref",
        "decision_prompt",
        "options",
        "pipeline_status"
      ],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "checkpoint_type": {
          "type": "string",
          "enum": [
            "direction-review",
            "architecture-options-selection",
            "architecture-confirmation",
            "prd-approval",
            "design-direction-selection",
            "pr-merge",
            "security-compliance-flag",
            "scope-change"
          ]
        },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "decision_prompt": { "type": "string", "minLength": 1 },
        "context_summary": { "type": ["string", "null"] },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["option", "consequence"],
            "properties": {
              "option": { "type": "string" },
              "consequence": { "type": "string" }
            }
          }
        },
        "urgency": {
          "type": "string",
          "enum": ["routine", "urgent", "critical"]
        },
        "pipeline_status": {
          "type": "string",
          "enum": ["paused", "resumed"]
        },
        "response_received": {
          "type": ["object", "null"],
          "required": ["option"],
          "properties": {
            "option": { "type": "string" },
            "notes": { "type": ["string", "null"] }
          }
        },
        "resume_instruction": { "type": ["string", "null"] },
        "decisions": {
          "type": "array",
          "description": "The separate decisions one sitting answers. A direction-review carries the intake questions, the PRD approval, the architecture option, and the design direction. Any gate may carry default-review items from pending-defaults.md. decision_prompt and options summarize the set.",
          "items": {
            "type": "object",
            "required": ["decision_id", "kind", "prompt"],
            "properties": {
              "decision_id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": [
                  "question",
                  "prd-approval",
                  "architecture-options-selection",
                  "design-direction-selection",
                  "default-review"
                ]
              },
              "prompt": { "type": "string", "minLength": 1 },
              "artifact_ref": { "type": ["string", "null"] },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["option", "consequence"],
                  "properties": {
                    "option": { "type": "string" },
                    "consequence": { "type": "string" }
                  }
                }
              },
              "recommended": {
                "type": ["string", "null"],
                "description": "The option or default taken if the human answers accept-defaults. Never set on architecture-options-selection or design-direction-selection, which the human always picks."
              },
              "response": { "type": ["string", "null"] }
            }
          }
        },
        "holds": {
          "type": "array",
          "description": "What this open gate holds: phase names, story or artifact ids, or all. Work outside the list keeps running while the gate is open. A checkpoint without holds holds all.",
          "items": { "type": "string", "minLength": 1 }
        },
        "held_batch": {
          "type": ["array", "null"],
          "description": "The routed units this gate holds, dispatched on resume. Replaces reconstructing held work from prose.",
          "items": { "type": "object" }
        }
      }
    }
  }
}
