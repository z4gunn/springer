{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springer.local/schemas/run-retrospective-v1.json",
  "title": "SPGR Run Retrospective v1",
  "description": "Per-run learnings written at run end. Learnings are advisory inputs to future Plan steps, cited as proposed rationale, never autonomous mutations. A learning that would change a rule carries requires_human_promotion true and is applied only through a human gate.",
  "allOf": [{ "$ref": "https://springer.local/schemas/_envelope-v1.json" }],
  "properties": {
    "artifact_type": { "const": "run-retrospective" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": ["retrospective_id", "run_id", "run_outcome", "learnings"],
      "properties": {
        "retrospective_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "run_outcome": {
          "type": "string",
          "enum": ["completed", "abandoned", "in-progress"]
        },
        "cycles_total": { "type": "integer", "minimum": 0 },
        "learnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["learning_id", "category", "observation", "recommendation", "confidence", "requires_human_promotion"],
            "properties": {
              "learning_id": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": ["routing-heuristic", "rule-change-proposal", "audit-pattern", "escalation-pattern"]
              },
              "observation": { "type": "string", "minLength": 1 },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" },
                "description": "cycle_id values that support this learning."
              },
              "recommendation": { "type": "string", "minLength": 1 },
              "confidence": {
                "type": "string",
                "enum": ["confirmed", "proposed"]
              },
              "source": {
            "type": "string",
            "enum": ["observed", "user-stated", "inferred"],
            "description": "How the learning was obtained. Only a user-stated learning may be cited by a run in another project."
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Repo paths the learning concerns, so a later prune can drop a learning whose files are gone."
          },
          "requires_human_promotion": {
                "type": "boolean",
                "description": "True when applying this learning would change a rule (WIP limit, gate set, routing policy). Such learnings are applied only through a human gate."
              },
              "remedy": {
                "type": "string",
                "enum": ["check", "reference", "none"],
                "description": "Where the fix lands. check: a mistake a script can see in a file, a diff, or an output, fixed by a validator rule, hook, test, or schema constraint named in remedy_target. reference: a judgment call, fixed by reference text that names the rule it displaces. none: an observation with no rule change."
              },
              "remedy_target": {
                "type": "string",
                "minLength": 1,
                "description": "For a check remedy, the script, hook, test, or schema that will catch the mistake."
              },
              "displaces": {
                "type": "string",
                "minLength": 1,
                "description": "For a reference remedy, the existing rule the new text removes or merges, per the rule budget."
              }
            },
            "allOf": [
              { "if": { "properties": { "remedy": { "const": "check" } }, "required": ["remedy"] }, "then": { "required": ["remedy_target"] } },
              { "if": { "properties": { "remedy": { "const": "reference" } }, "required": ["remedy"] }, "then": { "required": ["displaces"] } }
            ]
          }
        },
        "metrics": {
          "type": "object",
          "description": "Optional run counters.",
          "properties": {
            "total_cycles": { "type": "integer", "minimum": 0 },
            "gates_hit": { "type": "integer", "minimum": 0 },
            "escalations_raised": { "type": "integer", "minimum": 0 },
            "retries": { "type": "integer", "minimum": 0 },
            "audit_gates": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
